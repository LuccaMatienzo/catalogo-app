# ==== Configuración del Frontend ====
# Lo consume: catalogo-frontend (envsubst al arrancar nginx)
API_HOST=catalogo-api
API_PORT=8000

# ==== Configuración de la API ====
# Lo consume: catalogo-api
DB_HOST=catalogo-db
DB_PORT=27017
DB_NAME=catalogodb
APP_VERSION=v1
ROOT_PATH=/api
SEED_DEMO=true

# ==== Credenciales y Secretos ====
# Lo consumen: catalogo-db (para inicializar) y catalogo-api (para conectar)
DB_USER=catalogo_user
DB_PASSWORD=catalogo_pass

# Nota: Si se utilizara una MONGO_URI unificada, la cadena contendría la contraseña. 
# En Kubernetes (Semana 7), esa variable deberá ubicarse completa dentro de un Secret, nunca en un ConfigMap.
